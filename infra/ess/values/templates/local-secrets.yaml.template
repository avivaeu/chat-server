matrixAuthenticationService:
  additional:
    auth.yaml:
      config: |
        passwords:
          enabled: false

        account:
          email_change_allowed: false
          password_registration_enabled: false
          registration_token_required: false
          password_registration_email_required: false
          password_recovery_enabled: false
          login_with_email_allowed: false
          password_change_allowed: false

        upstream_oauth2:
          providers:
            - id: 01KS3C39WPPD1N8TEKD3Z41718
              human_name: Aviva ID
              issuer: https://aviva-uhb17i.eu1.zitadel.cloud
              client_id: "${ZITADEL_CLIENT_ID}"
              client_secret: "${ZITADEL_CLIENT_SECRET}"
              token_endpoint_auth_method: client_secret_post
              scope: "openid profile email"
              fetch_userinfo: true
              claims_imports:
                localpart:
                  action: require
                  template: "{{ user.email.split('@')[0] | lower }}"
                  on_conflict: set
                displayname:
                  action: suggest
                  template: "{{ user.name }}"
                email:
                  action: require
                  template: "{{ user.email }}"

    smtp.yaml:
      config: |
        email:
          from: '"Aviva Chat" <no-reply@avivaeu.org>'
          reply_to: '"Aviva Chat" <no-reply@avivaeu.org>'
          transport: smtp
          mode: starttls
          hostname: smtp.strato.de
          port: 587
          username: no-reply@avivaeu.org
          password: "${SMTP_PASSWORD}"
